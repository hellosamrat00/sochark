# --- Contact form (Resend) ---
# 1. Create a free account at https://resend.com
# 2. Create an API key at https://resend.com/api-keys and paste it here.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The inbox where contact-form messages should land (your personal email).
CONTACT_TO_EMAIL=youremail@example.com

# Optional. The "from" address shown on the email.
# Leave unset to use Resend's shared test sender (onboarding@resend.dev),
# which works immediately. To send from your own domain, verify it at
# https://resend.com/domains then set e.g. "Sochark <hello@sochark.com>".
# CONTACT_FROM_EMAIL=Sochark <hello@sochark.com>
